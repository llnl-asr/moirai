/* moirai's build configuration (generated by CMake from cmake/moirai_config.h.in). */
#ifndef MOIRAI_MOIRAI_CONFIG_H
#define MOIRAI_MOIRAI_CONFIG_H

#define MOIRAI_VERSION "@PROJECT_VERSION@"

/* Default of MOIRAI_TRACE_IO: trace POSIX/STDIO I/O. */
#define MOIRAI_DEFAULT_TRACE_IO @MOIRAI_DEFAULT_TRACE_IO@
/* dftracer was built with HDF5 / MPI tracing. */
#define MOIRAI_HAS_HDF5 @MOIRAI_HAS_HDF5@
#define MOIRAI_HAS_MPI @MOIRAI_HAS_MPI@
/* Artifacts are stored (RocksDB, through dftracer-utils). */
#define MOIRAI_HAS_ARTIFACT_STORE @MOIRAI_HAS_ARTIFACT_STORE@
/* Further dftracer features moirai was built with (MOIRAI_DFTRACER_FEATURES),
 * e.g. "CUDA;PAPI"; empty for none. */
#define MOIRAI_DFTRACER_FEATURES "@MOIRAI_DFTRACER_FEATURES@"

#endif /* MOIRAI_MOIRAI_CONFIG_H */
